*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
*.whl

# Virtual environments
.venv/
venv/
ENV/
env/
.env.bak/
venv.bak/

# Jupyter Notebook
.ipynb_checkpoints/

# Pytest / Coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.nox/
.tox/

# Type checkers / Linters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ============================================================================
# ⚛️ FRONTEND (Vite + React + TypeScript + Node)
# ============================================================================
# Dependencies
node_modules/
.pnp/
.pnp.js

# Build outputs
dist/
build/
.vite/
.cache/

# Testing / Coverage
coverage/
lcov-report/
.nyc_output/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE caches
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================================
